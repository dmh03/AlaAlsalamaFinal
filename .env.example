# Required for the AI features (reader, guard, written replies). Without it the app falls back to fixed texts.
ANTHROPIC_API_KEY=

# Optional
ALASALAMA_DB=data/alasalama.db
ALASALAMA_CHANNEL=webchat
# ALASALAMA_TRACE=1
# ALASALAMA_ONLY_PATIENTS=Sara

# Optional Telegram (create a bot with @BotFather). Only mapped patients are ever messaged externally.
# ALASALAMA_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# ALASALAMA_TELEGRAM_MAP=Sara=<your telegram chat id>

# Optional WhatsApp (Twilio Sandbox). Only patients listed in ALASALAMA_PHONE_MAP are ever messaged externally.
# ALASALAMA_CHANNEL=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ALASALAMA_PHONE_MAP=Sara=+9665XXXXXXXX
# TWILIO_WEBHOOK_URL=https://<your-tunnel>/webhooks/twilio

# Optional WhatsApp Cloud API (Meta)
# META_APP_SECRET=
# META_VERIFY_TOKEN=
