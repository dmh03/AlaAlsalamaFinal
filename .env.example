# Required for the AI features (reader, guard, written replies). Without it the app falls back to fixed texts.
ANTHROPIC_API_KEY=

# Optional
ALASALAMA_DB=data/alasalama.db
ALASALAMA_CHANNEL=webchat
# ALASALAMA_TRACE=1
# ALASALAMA_ONLY_PATIENTS=Sara

# Optional Telegram (create a bot with @BotFather). Only mapped patients are ever messaged externally.
# ALASALAMA_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# ALASALAMA_TELEGRAM_MAP=Sara=<your telegram chat id>
